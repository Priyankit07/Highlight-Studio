# ==============================================================================
# Football Highlight Studio - Environment Configuration
# ==============================================================================
# NOTE: Values left commented out will automatically use their respective APP_ENV
# mode defaults. Explicit uncommented values in this file or environment will
# override those defaults.
#
# Mode Defaults:
# - APP_ENV=local: MAX_UPLOAD_GB=10, RETENTION_DAYS=14, ENABLE_URL_IMPORT=true
# - APP_ENV=demo:  MAX_UPLOAD_GB=1,  RETENTION_DAYS=1,  ENABLE_URL_IMPORT=false
# ==============================================================================

# Application Environment Mode: 'local' (default) or 'demo'
# In 'demo' mode:
# - Settings, cookies, API tokens, and server diagnostic details are hidden
# - MAX_UPLOAD_GB defaults to 1 GB
# - MAX_CONCURRENT_JOBS defaults to 1
# - RETENTION_DAYS defaults to 1
# - ENABLE_URL_IMPORT defaults to false
# - File system paths are masked in all API responses
APP_ENV=local

# Optional Demo Password Gate
# If set, access to the API and web UI requires entering this password.
# Successful login sets an HttpOnly cookie 'demo_session'.
DEMO_PASSWORD=

# Optional Bearer Token Authentication
# If set, all requests to /api/* require header:
#   Authorization: Bearer <API_TOKEN>
# Leave blank for local development mode.
API_TOKEN=

# Concurrency & Resource Limits
MAX_CONCURRENT_JOBS=1
# MAX_UPLOAD_GB=10
# RETENTION_DAYS=14

# URL Import Configuration
# Set to false to disable yt-dlp URL import entirely (default: true in local, false in demo)
# ENABLE_URL_IMPORT=true

# Optional Netscape cookies.txt path for yt-dlp authenticated requests
# Recommended file permissions: chmod 0600 cookies.txt
YTDLP_COOKIES_FILE=

# Optional HTTP/HTTPS/SOCKS proxy URL for yt-dlp fallback (e.g. http://proxy.example.com:8080)
# Used automatically if YouTube or video hosts return bot-check or 403 blocks.
YTDLP_PROXY_URL=

# CORS Allowed Origin(s) - comma-separated
# In production, set to your deployed domain, e.g. https://highlight-studio.example.com
CORS_ORIGIN=

# Server Network Binding (Keep HOST=127.0.0.1 for non-Docker use; Docker Compose overrides this to 0.0.0.0)
HOST=127.0.0.1
PORT=8000
